{
  "name": "${localWorkspaceFolderBasename} Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  // Features - additional languages (tools are already in base image)
  "features": {
    // ========== LANGUAGES ==========
    // Node.js enabled by default (required for MCP servers)
    "./features/languages/nodejs": {},
    // Go enabled for this Terraform provider project
    "./features/languages/go": {},
    // ========== KUBERNETES ==========
    // Local Kubernetes development with kind (requires docker-outside-of-docker)
    "./features/kubernetes": {},
    // ========== INFRASTRUCTURE ==========
    // Infra tools: terragrunt, tflint, infracost, cfssl, ansible-lint, molecule
    "./features/infrastructure": {},
    // ========== TERRAFORM CLI ==========
    // Terraform CLI (required for provider development)
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    // ========== EXTERNAL ==========
    // Docker support
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true,
      "dockerDashComposeVersion": "v2"
    }
  },
  // Configure tool-specific properties
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          }
        },
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "files.trimTrailingWhitespace": true,
        "files.exclude": {
          "**/.grepai": true,
          "**/.git": true
        },
        // Go-specific settings
        "[go]": {
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        "go.toolsManagement.autoUpdate": true,
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        // Bazel settings
        "bazel.buildifierExecutable": "/home/vscode/.cache/go/bin/buildifier",
        "bazel.enableCodeLens": true
      },
      "extensions": [
        // Base extensions (from template)
        "vscode-icons-team.vscode-icons",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "bierner.markdown-mermaid",
        "ms-azuretools.vscode-docker",
        "hashicorp.terraform",
        // Project-specific extensions
        "usernamehw.errorlens",
        "golang.go",
        "bazelbuild.vscode-bazel",
        "emeraldwalk.runonsave"
      ]
    }
  },
  // ========== LIFECYCLE COMMANDS ==========
  // All commands check for script existence to avoid failures if scripts are missing
  "waitFor": "postCreateCommand",
  "initializeCommand": "[ -f \"${localWorkspaceFolder}/.devcontainer/hooks/lifecycle/initialize.sh\" ] && bash \"${localWorkspaceFolder}/.devcontainer/hooks/lifecycle/initialize.sh\" || true",
  "onCreateCommand": {
    "chmod-hooks": "chmod +x /workspace/.devcontainer/hooks/lifecycle/*.sh 2>/dev/null || true",
    "run-hook": "[ -f /workspace/.devcontainer/hooks/lifecycle/onCreate.sh ] && /workspace/.devcontainer/hooks/lifecycle/onCreate.sh || true"
  },
  "updateContentCommand": "[ -f /workspace/.devcontainer/hooks/lifecycle/updateContent.sh ] && /workspace/.devcontainer/hooks/lifecycle/updateContent.sh || true",
  "postCreateCommand": "[ -f /workspace/.devcontainer/hooks/lifecycle/postCreate.sh ] && /workspace/.devcontainer/hooks/lifecycle/postCreate.sh || true",
  "postStartCommand": "[ -f /workspace/.devcontainer/hooks/lifecycle/postStart.sh ] && /workspace/.devcontainer/hooks/lifecycle/postStart.sh || true",
  "postAttachCommand": "[ -f /workspace/.devcontainer/hooks/lifecycle/postAttach.sh ] && /workspace/.devcontainer/hooks/lifecycle/postAttach.sh || true",
  "forwardPorts": [],
  "remoteUser": "vscode",
  "shutdownAction": "none"
}
